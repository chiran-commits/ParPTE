# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com          # these accounts get admin + every feature free
WHISPER_MODEL=base.en                 # tiny.en | base.en | small.en | medium.en  (bigger = more accurate, slower)
# LANGUAGETOOL_URL=http://localhost:8010   # LanguageTool server for full grammar checks (docker-compose starts one)
# ANTHROPIC_API_KEY=sk-ant-...             # optional: Claude writes the per-answer coach summaries
# COACH_MODEL=claude-haiku-5-5
# BILLING_PROVIDER=payhere                 # see docs/COMMERCIAL.md
