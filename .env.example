# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com          # these accounts get admin + every feature free
WHISPER_MODEL=base.en                 # tiny.en | base.en | small.en | medium.en  (bigger = more accurate, slower)
# LANGUAGETOOL_URL=http://localhost:8010   # optional self-hosted LanguageTool for stronger grammar checks
# BILLING_PROVIDER=payhere                 # see docs/COMMERCIAL.md
